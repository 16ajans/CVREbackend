NODE_ENV="production" # https://expressjs.com/th/advanced/best-practice-performance.html

DISCORD_OAUTH_ID="" # https://discord.com/developers/applications > application > OAuth2
DISCORD_OAUTH_SECRET=""
DISCORD_OAUTH_SCOPES=""
DISCORD_OAUTH_REDIRECT_URI=""
DISCORD_BOT_TOKEN="" # https://discord.com/developers/applications > application > Bot

PORT="" # local port for Express server including API (ex: 3000)
SESSION_SECRET="" # session secret for https://github.com/expressjs/session

MONGODB_URI="" # mongodb instance URI (ex: mongodb+srv://user:pass@mydb.bananas.mongodb.net/prod)

GUILD_ID="" # CVRE discord server ID (ex: 425828850266669058)
ADMIN_ROLE_ID="" # discord role ID to be given site "admin" access (ex: 609277667648339968)
SCORESABER_ROLE_ID="" # discord role ID to be given scoresaber access
CAPTAIN_ROLE_IDS="" # discord role ID allowed to manage teams

MORGAN="" # request logging format https://github.com/expressjs/morgan
ROLE_CRON="" # sets timing for applying roles to discord server members https://github.com/kelektiv/node-cron